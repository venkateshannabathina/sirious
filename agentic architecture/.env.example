# Copy this file to .env and add only the providers you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-120b
GROK_MODEL=grok-3-mini

# Speech and local-browser security
SIRIOUS_TTS_VOICE=en-US-AriaNeural
SIRIOUS_PROVIDER_TIMEOUT_SECONDS=45
SIRIOUS_ALLOWED_ORIGINS=http://127.0.0.1:8005,http://localhost:8005
SIRIOUS_ALLOWED_HOSTS=127.0.0.1,localhost
