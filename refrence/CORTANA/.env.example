# Language providers. Configure at least one for generated conversation.
GROQ_API_KEY=
OPENAI_API_KEY=

# Provider models can be changed without editing application code.
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Runtime.
HOST=127.0.0.1
PORT=8005
CORTANA_RELOAD=false
CORTANA_VOICE=en-US-EmmaNeural

# Comma-separated browser origins for cross-origin development.
CORTANA_CORS_ORIGINS=http://127.0.0.1:8005,http://localhost:8005

